@model SafeVault.Models.AdminEditUserViewModel
@{
    ViewData["Title"] = "Edit User";
}
<div class="form-container">
    <div class="form-card">
        <h2>✏️ Edit User</h2>
        <p class="form-subtitle">ID: <strong>#@Model.UserID</strong></p>

        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.ErrorCount > 0)
        {
            <div asp-validation-summary="All" class="alert alert-danger"></div>
        }

        <form id="editUserForm" asp-action="EditUser" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="UserID" />

            <div class="form-group">
                <label asp-for="Username">Username</label>
                <input asp-for="Username" class="form-control" placeholder="3–50 chars, letters/numbers/_" autocomplete="off" />
                <span asp-validation-for="Username" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email">Email</label>
                <input asp-for="Email" class="form-control" placeholder="user@example.com" autocomplete="off" />
                <span asp-validation-for="Email" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Role">Role</label>
                <select asp-for="Role" class="form-control">
                    <option value="user">User</option>
                    <option value="admin">Admin</option>
                </select>
                <span asp-validation-for="Role" class="field-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="NewPassword">New Password <span class="optional-label">(leave blank to keep current)</span></label>
                <div class="password-wrapper">
                    <input asp-for="NewPassword" class="form-control" placeholder="Min 8 chars, upper+lower+digit+special (@@  $  !  %  *  ?  &)" autocomplete="new-password" />
                    <button type="button" class="btn-show-password" aria-label="Toggle password visibility" onclick="togglePassword(this)">
                        <span class="eye-icon">👁</span>
                    </button>
                </div>
                <span asp-validation-for="NewPassword" class="field-error"></span>
            </div>

            <div class="form-actions">
                <button type="submit" class="btn btn-primary btn-full">Save Changes</button>
                <a href="/Admin/Dashboard" class="btn btn-secondary btn-full" style="margin-top:0.6rem">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        document.getElementById('editUserForm').addEventListener('submit', function(e) {
            if (!validateFormSecurity(this)) e.preventDefault();
        });
    </script>
}
